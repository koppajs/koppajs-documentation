{
  "name": "koppajs-documentation",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "description": "KoppaJS documentation app with standalone runtime and embeddable documentation surface.",
  "author": "Bastian Bensch",
  "license": "Apache-2.0",
  "keywords": [
    "koppajs",
    "documentation",
    "website",
    "vite",
    "router",
    "typescript",
    "playwright",
    "vitest"
  ],
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "exports": {
    ".": "./src/integration.ts",
    "./integration": "./src/integration.ts",
    "./routes": "./src/documentation-config.ts",
    "./ecosystem": "./src/ecosystem.ts",
    "./code-blocks": "./src/code-blocks.ts",
    "./theme.css": "./src/theme.css"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('coverage',{recursive:true,force:true});require('node:fs').rmSync('playwright-report',{recursive:true,force:true});require('node:fs').rmSync('test-results',{recursive:true,force:true})\"",
    "dev": "vite --host",
    "build": "npm run typecheck && vite build",
    "serve": "vite preview",
    "serve:e2e": "vite preview --host 127.0.0.1 --strictPort --port 4273",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:run",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "npm run test:coverage",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "test:e2e:ui": "npm run build && playwright test --ui",
    "check:docs": "node scripts/check-doc-contract.mjs",
    "lint:staged": "lint-staged",
    "prepare": "husky",
    "check": "npm run check:docs && npm run lint && npm run format:check && npm run typecheck && npm run test:run && npm run build",
    "validate": "npm run check && npm run test:e2e",
    "release:check": "npm run validate"
  },
  "peerDependencies": {
    "@koppajs/koppajs-core": "^3.0.7",
    "@koppajs/koppajs-router": "^0.1.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^10.0.1",
    "@koppajs/koppajs-core": "^3.0.7",
    "@koppajs/koppajs-router": "^0.1.2",
    "@koppajs/koppajs-vite-plugin": "^1.0.4",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.4.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.0.3",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.3",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "7.2.6",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,html,json,md,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.2.7",
    "@fontsource/geist-sans": "^5.2.5"
  }
}
