[template]
  <section class="documentation-shell">
    <a class="koppa-skip-link" href="#docs-article">Skip to content</a>

    <div class="documentation-shell__grid">
      <aside class="documentation-shell__sidebar">
        <div class="documentation-shell__sidebar-frame">
          <nav class="documentation-shell__nav" :aria-label="navigationLabel">
            <div
              loop="item in navItems"
              class="documentation-shell__nav-group"
            >
              <a
                class="documentation-shell__nav-link {{ item.active && 'is-active' }}"
                :href="item.href"
                :data-route="item.href"
                :aria-current="item.active ? 'page' : null"
              >
                {{ item.label }}
              </a>

              <div
                if="item.children.length"
                class="documentation-shell__nav-children"
              >
                <a
                  loop="child in item.children"
                  class="documentation-shell__nav-child {{ child.active && 'is-active' }}"
                  :href="child.href"
                  :data-route="child.href"
                  :aria-current="child.active ? 'page' : null"
                >
                  {{ child.label }}
                </a>
              </div>
            </div>
          </nav>
        </div>
      </aside>

      <main id="docs-article" class="documentation-shell__main">
        {{ pageHtml }}
      </main>
    </div>
  </section>
[/template]

[ts]
  import {
    getDocumentationNavigationItems,
    getDocumentationShellCopy,
  } from "../documentation-config";

  const isPathActive = (currentPath, candidatePath) => {
    if (!candidatePath || candidatePath === "/overview") {
      return currentPath === "/overview";
    }

    return currentPath === candidatePath || currentPath.startsWith(`${candidatePath}/`);
  };

  const mapNavigation = (items, currentPath) =>
    items.map((item) => ({
      ...item,
      active: isPathActive(currentPath, item.path),
      children: item.children.map((child) => ({
        ...child,
        active: currentPath === child.path,
      })),
    }));

  return {
    props: {
      path: { type: String, required: true },
      pageHtml: { type: String, default: "" },
    },
    state: {
      navigationLabel: "Documentation navigation",
      navItems: [],
    },
    methods: {
      syncShell() {
        this.navigationLabel = getDocumentationShellCopy().navigationLabel;
        this.navItems = mapNavigation(
          getDocumentationNavigationItems(),
          this.path,
        );
      },
    },
    created() {
      this.syncShell();
    },
  };
[/ts]
