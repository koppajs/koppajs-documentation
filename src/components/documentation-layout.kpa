[template]
  <section class="documentation-layout">
    <aside class="documentation-layout__sidebar">
      <div class="documentation-layout__sidebar-inner">
        <a
          href="{{ homeHref }}"
          :data-route="homeHref"
          class="documentation-layout__brand"
        >
          <span class="documentation-layout__eyebrow">{{ copy.eyebrow }}</span>
          <strong class="documentation-layout__brand-title">{{ copy.brandTitle }}</strong>
          <span class="documentation-layout__brand-copy">{{ copy.brandCopy }}</span>
        </a>

        <nav class="documentation-layout__nav" :aria-label="copy.navigationAriaLabel">
          <a
            loop="item in navItems"
            href="{{ item.href }}"
            :data-route="item.href"
            class="documentation-layout__nav-link {{ item.active && 'is-active' }}"
            :aria-current="item.active ? 'page' : null"
          >
            {{ item.label }}
          </a>
        </nav>

        <div class="documentation-layout__locale">
          <p class="documentation-layout__meta-label">{{ copy.languageLabel }}</p>
          <div class="documentation-layout__locale-switch" aria-label="{{ copy.languageLabel }}">
            <button
              type="button"
              class="documentation-layout__locale-button {{ locale === 'en' && 'is-active' }}"
              data-locale="en"
              onClick="switchLocale"
            >
              English
            </button>
            <button
              type="button"
              class="documentation-layout__locale-button {{ locale === 'de' && 'is-active' }}"
              data-locale="de"
              onClick="switchLocale"
            >
              Deutsch
            </button>
          </div>
        </div>

        <footer class="documentation-layout__footer" :aria-label="copy.footerAriaLabel">
          <a
            href="https://github.com/orgs/koppajs/repositories"
            class="documentation-layout__footer-link documentation-layout__footer-link--github"
            :aria-label="copy.githubAriaLabel"
            title="GitHub"
            target="_blank"
            rel="noreferrer"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" focusable="false">
              <path
                d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.24c-3.34.72-4.04-1.41-4.04-1.41-.55-1.38-1.33-1.75-1.33-1.75-1.09-.74.08-.72.08-.72 1.2.09 1.84 1.24 1.84 1.24 1.08 1.83 2.83 1.3 3.52.99.11-.77.42-1.3.76-1.6-2.66-.3-5.47-1.31-5.47-5.85 0-1.29.47-2.35 1.24-3.18-.12-.3-.54-1.52.12-3.16 0 0 1.01-.32 3.3 1.21a11.5 11.5 0 0 1 6 0c2.29-1.53 3.3-1.21 3.3-1.21.66 1.64.24 2.86.12 3.16.77.83 1.24 1.89 1.24 3.18 0 4.55-2.82 5.54-5.5 5.84.43.37.82 1.1.82 2.21v3.27c0 .32.22.7.83.58A12 12 0 0 0 12 .5Z"
              ></path>
            </svg>
          </a>
          <a
            href="https://github.com/koppajs/koppajs-documentation"
            class="documentation-layout__footer-link"
            :aria-label="copy.docsAriaLabel"
            :title="copy.docsTitle"
            target="_blank"
            rel="noreferrer"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false">
              <path d="M8 3.5h6.5L19 8v12a.5.5 0 0 1-.5.5h-11A.5.5 0 0 1 7 20V4a.5.5 0 0 1 .5-.5Z"></path>
              <path d="M14 3.5V8h5"></path>
              <path d="M10 12h4"></path>
              <path d="M10 16h4"></path>
            </svg>
          </a>
          <a
            href="https://github.com/koppajs/koppajs-website"
            class="documentation-layout__footer-link"
            :aria-label="copy.websiteAriaLabel"
            :title="copy.websiteTitle"
            target="_blank"
            rel="noreferrer"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false">
              <rect x="3.5" y="4.5" width="17" height="12" rx="1.5"></rect>
              <path d="M8 19.5h8"></path>
              <path d="M12 16.5v3"></path>
            </svg>
          </a>
        </footer>
      </div>
    </aside>

    <main class="documentation-layout__main">
      <slot></slot>
    </main>
  </section>
[/template]

[ts]
  import {
    getDocumentationRouteMap,
    getDocumentationNavigationItems,
    getDocumentationShellCopy,
  } from "../documentation-config";
  import { getKoppaLocale, setKoppaLocale } from "../i18n";

  const normalizePath = (path = "/") => {
    if (!path || path === "/") {
      return "/";
    }

    return `/${path.replace(/^\/+|\/+$/g, "")}`;
  };

  return {
    props: {
      path: { type: String, required: true },
    },
    state: {
      locale: "en",
      copy: {},
      homeHref: "/",
      navItems: [],
    },
    methods: {
      switchLocale(event) {
        const nextLocale = event.currentTarget?.dataset?.locale;

        if (nextLocale) {
          setKoppaLocale(nextLocale);
        }
      },
    },
    created() {
      this.locale = getKoppaLocale();
      this.copy = getDocumentationShellCopy(this.locale);

      const currentPath = normalizePath(window.location.pathname);
      const routeMap = getDocumentationRouteMap();

      this.homeHref = routeMap["/"] ?? "/";
      this.navItems = getDocumentationNavigationItems(this.locale).map((item) => {
        const href = routeMap[item.path] ?? item.path;

        return {
          label: item.label,
          href,
          active: href === currentPath,
        };
      });
    },
  };
[/ts]
