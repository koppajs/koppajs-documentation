[template]
  <div class="shell">
    <header class="hero">
      <div class="hero-copy">
        <p class="eyebrow">Canonical docs website</p>
        <h1>Document the framework where it is used.</h1>
        <p class="lead">
          This repository now ships a real KoppaJS documentation application:
          routed pages, package guidance, and a testable shell built on
          <code>@koppajs/koppajs-core</code>,
          <code>@koppajs/koppajs-router</code>, and
          <code>@koppajs/koppajs-vite-plugin</code>.
        </p>

        <div class="hero-actions">
          <a data-route="/getting-started" href="/getting-started" class="action action--primary">
            Get started
          </a>
          <a data-route="/packages" href="/packages" class="action">
            Package map
          </a>
        </div>
      </div>

      <div class="hero-grid" aria-label="Documentation highlights">
        <article class="feature-card">
          <p class="feature-label">Core</p>
          <h2>Runtime-owned rendering</h2>
          <p>
            The app shell and route pages are native KoppaJS single-file
            components so the docs site exercises the framework directly.
          </p>
        </article>

        <article class="feature-card">
          <p class="feature-label">Router</p>
          <h2>App-owned docs routes</h2>
          <p>
            Navigation, active-link state, and the fallback page are all driven
            through the published KoppaJS router contract.
          </p>
        </article>

        <article class="feature-card">
          <p class="feature-label">Quality</p>
          <h2>Docs must be verifiable</h2>
          <p>
            Vitest, Playwright, linting, formatting, type checks, and CI now
            protect the website baseline instead of only the root markdown
            files.
          </p>
        </article>
      </div>
    </header>

    <nav class="section-nav" aria-label="Primary">
      <a data-route="/" href="/" class="section-link">Overview</a>
      <a data-route="/getting-started" href="/getting-started" class="section-link">
        Getting Started
      </a>
      <a data-route="/packages" href="/packages" class="section-link">Packages</a>
      <a data-route="/testing" href="/testing" class="section-link">Testing</a>
    </nav>

    <main id="app-outlet" class="app-outlet" aria-live="polite"></main>

    <footer class="site-footer">
      <p>
        KoppaJS package references:
        <a href="https://github.com/koppajs/koppajs-core">core</a>,
        <a href="https://github.com/koppajs/koppajs-vite-plugin">vite plugin</a>,
        <a href="https://github.com/koppajs/koppajs-router">router</a>.
      </p>
    </footer>
  </div>
[/template]

[css]
  .shell {
    width: min(1180px, calc(100vw - 1.5rem));
    margin: 0 auto;
    padding: 1rem 0 3rem;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.95fr);
    gap: 1.4rem;
    padding: 1.4rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 2rem;
    background:
      linear-gradient(150deg, rgba(8, 20, 31, 0.94), rgba(16, 29, 45, 0.72)),
      radial-gradient(circle at top right, rgba(255, 188, 106, 0.16), transparent 40%);
    box-shadow: 0 32px 90px rgba(0, 0, 0, 0.28);
    backdrop-filter: blur(20px);
    animation: hero-enter 0.7s ease-out both;
  }

  .hero-copy,
  .hero-grid,
  .site-footer {
    display: flex;
    flex-direction: column;
  }

  .hero-copy {
    gap: 1rem;
    justify-content: center;
  }

  .eyebrow,
  .feature-label {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.28em;
    font-size: 0.78rem;
    color: #ffbc6a;
  }

  h1,
  h2,
  p {
    margin: 0;
  }

  h1 {
    max-width: 12ch;
    font-size: clamp(2.6rem, 7vw, 4.9rem);
    line-height: 0.96;
  }

  .lead {
    max-width: 56ch;
    color: rgba(246, 243, 234, 0.82);
    line-height: 1.72;
  }

  code {
    color: #58cebd;
  }

  .hero-actions,
  .section-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .action,
  .section-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.9rem;
    padding: 0 1.25rem;
    border-radius: 999px;
    text-decoration: none;
    transition:
      transform 0.18s ease,
      background 0.24s ease,
      border-color 0.24s ease;
  }

  .action {
    border: 1px solid rgba(255, 188, 106, 0.26);
    background: rgba(255, 188, 106, 0.08);
    color: #fff3de;
  }

  .action--primary {
    background: #ffbc6a;
    border-color: #ffbc6a;
    color: #091018;
    font-weight: 700;
  }

  .action:hover,
  .section-link:hover {
    transform: translateY(-1px);
  }

  .hero-grid {
    display: grid;
    gap: 1rem;
  }

  .feature-card {
    padding: 1rem 1.05rem;
    border: 1px solid rgba(88, 206, 189, 0.16);
    border-radius: 1.3rem;
    background: rgba(10, 19, 30, 0.68);
  }

  .feature-card h2 {
    margin-top: 0.45rem;
    font-size: 1.2rem;
  }

  .feature-card p:last-child {
    margin-top: 0.65rem;
    color: rgba(246, 243, 234, 0.78);
    line-height: 1.62;
  }

  .section-nav {
    margin-top: 1rem;
    padding: 0.35rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    background: rgba(8, 17, 26, 0.72);
    position: sticky;
    top: 0.75rem;
    z-index: 2;
    backdrop-filter: blur(18px);
  }

  .section-link {
    border: 1px solid transparent;
    color: rgba(246, 243, 234, 0.76);
  }

  .section-link.is-active,
  .section-link[aria-current="page"] {
    background: rgba(88, 206, 189, 0.16);
    border-color: rgba(88, 206, 189, 0.28);
    color: #f6f3ea;
    font-weight: 700;
  }

  .app-outlet {
    padding-top: 1rem;
  }

  .site-footer {
    gap: 0.5rem;
    margin-top: 1rem;
    padding: 1rem 0.4rem 0;
    color: rgba(246, 243, 234, 0.66);
  }

  .site-footer a {
    color: #58cebd;
  }

  @keyframes hero-enter {
    from {
      opacity: 0;
      transform: translateY(24px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
    }

    h1 {
      max-width: 14ch;
    }
  }

  @media (max-width: 640px) {
    .shell {
      width: min(100vw - 0.75rem, 1180px);
      padding-top: 0.4rem;
    }

    .hero {
      padding: 1rem;
      border-radius: 1.4rem;
    }

    .section-nav {
      border-radius: 1.4rem;
    }
  }
[/css]
