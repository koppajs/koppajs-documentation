[template]
  <documentation-layout path="/">
    <section class="docs-page">
      <section class="docs-section-card docs-section-card--strong">
        <p class="docs-eyebrow">Nicht gefunden</p>
        <h1 class="docs-title">Diese Dokumentationsseite existiert nicht.</h1>
        <p class="docs-lead">
          Die Route ist bewusst als Fallback hinterlegt, damit unbekannte URLs
          kontrolliert und testbar behandelt werden. Über die Übersicht kommst
          du zurück in die reguläre Dokumentationsstruktur.
        </p>
        <div class="docs-action-row">
          <a href="/" class="docs-button docs-button--primary">
            Zur Übersicht
          </a>
          <a href="/guides" class="docs-button">
            Zu den Guides
          </a>
        </div>
      </section>
    </section>
  </documentation-layout>
[/template]
