[template]
  {{ locale === 'en' ? contentEn : '' }}
  <documentation-api-page-de if="locale === 'de'"></documentation-api-page-de>
[/template]

[ts]
  import contentEn from "../content/pages/en/api-page-content";
  import { getKoppaLocale } from "../i18n";

  return {
    state: {
      locale: getKoppaLocale(),
      contentEn,
    },
  };
[/ts]
